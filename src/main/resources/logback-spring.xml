<configuration>
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="LOKI"
              class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>http://localhost:3100/loki/api/v1/push</url>
        </http>

        <format class="com.github.loki4j.logback.JsonEncoder">
            <label>
                <pattern>app=hospital-scheduling-service,service=scheduling-service,environment=dev</pattern>
            </label>
            <message>
                <pattern>level=%level logger=%logger{36} thread=%thread message=%msg %ex</pattern>
            </message>
        </format>

        <batchMaxItems>100</batchMaxItems>
        <batchTimeoutMs>10000</batchTimeoutMs>
        <verbose>true</verbose>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOKI"/>
    </root>
</configuration>